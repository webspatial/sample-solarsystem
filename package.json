{
  "name": "sample-solarsystem",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "XR_ENV=avp vite",
    "build": "tsc -b && XR_ENV=avp vite build",
    "build:vercel-avp": "node generate-icons.mjs && pnpm run build",
    "generate-icons": "node generate-icons.mjs",
    "lint": "eslint .",
    "preview": "vite preview --host --port 5173 --outDir dist/webspatial/avp",
    "avp": "pnpm run build && webspatial-builder run --base=http://localhost:5173"
  },
  "dependencies": {
    "@webspatial/core-sdk": "^1.6.1",
    "@webspatial/react-sdk": "^1.6.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.6.0",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@webspatial/builder": "^1.6.1",
    "@webspatial/platform-visionos": "^1.6.1",
    "@webspatial/vite-plugin": "^1.0.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
